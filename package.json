{
  "name": "the-sixth-element",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:security": "vitest run tests/6-security",
    "security:audit": "npm audit --audit-level=high",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile=test-report.json",
    "test:report": "node scripts/traceability-reporter.js",
    "backlog:refresh": "python scripts/refresh-backlog.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
